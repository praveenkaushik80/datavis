# Environment variables for the Vercel project (Project > Settings > Environment Variables).
# DATABASE_URL is added automatically when you connect a Neon Postgres database from the Vercel Marketplace.
DATABASE_URL=
FERNET_KEY=
JWT_SECRET=
INTERNAL_TOKEN=
HOP_API_TOKEN=
HOP_ADMIN_TOKEN=
AUTH_MODE=otp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Models: OpenRouter directly (no LiteLLM on Vercel). Set a credit limit on this key in OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL_AGENT=anthropic/claude-sonnet-5
LLM_MODEL_RESEARCH=anthropic/claude-sonnet-5
LLM_FALLBACK_MODELS=anthropic/claude-haiku-4.5

# Cube (hosted elsewhere, see deploy/remote-services.compose.yml)
CUBE_API_URL=https://your-cube-host/cubejs-api/v1
CUBE_API_SECRET=

# Optional
OM_URL=
OM_TOKEN=
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
