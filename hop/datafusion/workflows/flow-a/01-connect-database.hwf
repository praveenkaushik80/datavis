<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>01-connect-database</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Flow A, ribbon 1, steps 1-5: choose the database, enter credentials, verify, store credentials encrypted and run the metadata catalog pipeline automatically.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/25 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/25 00:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>DB_NAME</name>
      <default_value>sales</default_value>
      <description>DataFusion connection name (lowercase, e.g. sales)</description>
    </parameter>
    <parameter>
      <name>DB_TYPE</name>
      <default_value>postgres</default_value>
      <description>postgres (MVP1); mysql, mssql, oracle, snowflake (MVP2)</description>
    </parameter>
    <parameter>
      <name>DB_HOST</name>
      <default_value>client-db</default_value>
      <description>Host name</description>
    </parameter>
    <parameter>
      <name>DB_PORT</name>
      <default_value>5432</default_value>
      <description>Port</description>
    </parameter>
    <parameter>
      <name>DB_DATABASE</name>
      <default_value>shop</default_value>
      <description>Database name</description>
    </parameter>
    <parameter>
      <name>DB_USER</name>
      <default_value>datafusion_ro</default_value>
      <description>Read-only account</description>
    </parameter>
    <parameter>
      <name>DB_PASSWORD</name>
      <default_value></default_value>
      <description>Password (sent once, stored encrypted, never logged)</description>
    </parameter>
    <parameter>
      <name>DB_OPTIONS</name>
      <default_value>{"schemas": ["public"]}</default_value>
      <description>JSON options: schemas, account, warehouse, role, service_name</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Verify the connection</name>
      <description>POST /api/connections/verify</description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/pipelines/call-datafusion-api.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <parameter>
          <name>API_PATH</name>
          <stream_name/>
          <value>/api/connections/verify</value>
        </parameter>
        <parameter>
          <name>API_TOKEN</name>
          <stream_name/>
          <value>${DF_API_TOKEN}</value>
        </parameter>
        <parameter>
          <name>HTTP_METHOD</name>
          <stream_name/>
          <value>POST</value>
        </parameter>
        <parameter>
          <name>BODY_JSON</name>
          <stream_name/>
          <value>{"name":"${DB_NAME}","db_type":"${DB_TYPE}","host":"${DB_HOST}","port":${DB_PORT},"database":"${DB_DATABASE}","username":"${DB_USER}","password":"${DB_PASSWORD}","options":${DB_OPTIONS}}</value>
        </parameter>
        <pass_all_parameters>N</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Store credentials and run catalog</name>
      <description>POST /api/connections</description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/pipelines/call-datafusion-api.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <parameter>
          <name>API_PATH</name>
          <stream_name/>
          <value>/api/connections</value>
        </parameter>
        <parameter>
          <name>API_TOKEN</name>
          <stream_name/>
          <value>${DF_API_TOKEN}</value>
        </parameter>
        <parameter>
          <name>HTTP_METHOD</name>
          <stream_name/>
          <value>POST</value>
        </parameter>
        <parameter>
          <name>BODY_JSON</name>
          <stream_name/>
          <value>{"name":"${DB_NAME}","db_type":"${DB_TYPE}","host":"${DB_HOST}","port":${DB_PORT},"database":"${DB_DATABASE}","username":"${DB_USER}","password":"${DB_PASSWORD}","options":${DB_OPTIONS},"run_catalog":true}</value>
        </parameter>
        <pass_all_parameters>N</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>START</from>
      <to>Verify the connection</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Verify the connection</from>
      <to>Store credentials and run catalog</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>Flow A, ribbon 1, steps 1-5: choose the database, enter credentials, verify, store credentials encrypted and run the metadata catalog pipeline automatically.</note>
      <xloc>64</xloc>
      <yloc>192</yloc>
      <width>620</width>
      <heigth>60</heigth>
      <fontname/>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>244</backgroundcolorred>
      <backgroundcolorgreen>246</backgroundcolorgreen>
      <backgroundcolorblue>248</backgroundcolorblue>
      <bordercolorred>196</bordercolorred>
      <bordercolorgreen>203</bordercolorgreen>
      <bordercolorblue>212</bordercolorblue>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
