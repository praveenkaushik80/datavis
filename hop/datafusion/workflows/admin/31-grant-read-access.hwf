<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>31-grant-read-access</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Admin: grant read access for a department or user to a database, optionally limited to tables and with restricted columns.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/25 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/25 00:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>SUBJECT_TYPE</name>
      <default_value>department</default_value>
      <description>department | user</description>
    </parameter>
    <parameter>
      <name>SUBJECT</name>
      <default_value></default_value>
      <description>Department name or email</description>
    </parameter>
    <parameter>
      <name>DB_NAME</name>
      <default_value>sales</default_value>
      <description>DataFusion connection name (lowercase, e.g. sales)</description>
    </parameter>
    <parameter>
      <name>TABLES</name>
      <default_value>[]</default_value>
      <description>JSON list, e.g. ["public.orders"]; [] = all tables</description>
    </parameter>
    <parameter>
      <name>DENIED_COLUMNS</name>
      <default_value>[]</default_value>
      <description>JSON list, e.g. ["public.customers.email"]</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Grant read access</name>
      <description>POST /api/admin/permissions</description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/pipelines/call-datafusion-api.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
        <parameter>
          <name>API_PATH</name>
          <stream_name/>
          <value>/api/admin/permissions</value>
        </parameter>
        <parameter>
          <name>API_TOKEN</name>
          <stream_name/>
          <value>${DF_ADMIN_TOKEN}</value>
        </parameter>
        <parameter>
          <name>HTTP_METHOD</name>
          <stream_name/>
          <value>POST</value>
        </parameter>
        <parameter>
          <name>BODY_JSON</name>
          <stream_name/>
          <value>{"subject_type":"${SUBJECT_TYPE}","subject":"${SUBJECT}","connection":"${DB_NAME}","tables":${TABLES},"denied_columns":${DENIED_COLUMNS}}</value>
        </parameter>
        <pass_all_parameters>N</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>START</from>
      <to>Grant read access</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>Admin: grant read access for a department or user to a database, optionally limited to tables and with restricted columns.</note>
      <xloc>64</xloc>
      <yloc>192</yloc>
      <width>620</width>
      <heigth>60</heigth>
      <fontname/>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>244</backgroundcolorred>
      <backgroundcolorgreen>246</backgroundcolorgreen>
      <backgroundcolorblue>248</backgroundcolorblue>
      <bordercolorred>196</bordercolorred>
      <bordercolorgreen>203</bordercolorgreen>
      <bordercolorblue>212</bordercolorblue>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
