<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>save-api-response-to-file</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Saves an API response to a local file.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>API_PATH</name>
        <default_value>/health</default_value>
        <description>Path under DF_API_URL</description>
      </parameter>
      <parameter>
        <name>OUTPUT_FILE</name>
        <default_value></default_value>
        <description>Local file to write</description>
      </parameter>
      <parameter>
        <name>API_TOKEN</name>
        <default_value>${DF_API_TOKEN}</default_value>
        <description>Bearer token</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/25 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/25 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Build request</from>
      <to>Call DataFusion API</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Call DataFusion API</from>
      <to>Drop request secrets</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Drop request secrets</from>
      <to>Show status</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Show status</from>
      <to>HTTP 2xx?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HTTP 2xx?</from>
      <to>Write response to file</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HTTP 2xx?</from>
      <to>Show error</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Show error</from>
      <to>Fail with API error</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Build request</name>
    <type>GetVariable</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>url</name>
        <variable>${DF_API_URL}${API_PATH}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>method</name>
        <variable>GET</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>body</name>
        <variable>{}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>auth</name>
        <variable>Bearer ${API_TOKEN}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Call DataFusion API</name>
    <type>Rest</type>
    <description>Calls the DataFusion API with the Hop service token.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>JSON</applicationType>
    <connection_name/>
    <url/>
    <urlInField>Y</urlInField>
    <urlField>url</urlField>
    <dynamicMethod>Y</dynamicMethod>
    <methodFieldName>method</methodFieldName>
    <method>POST</method>
    <bodyField>body</bodyField>
    <httpLogin/>
    <httpPassword>Encrypted </httpPassword>
    <proxyHost/>
    <proxyPort/>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <ignoreSsl>N</ignoreSsl>
    <connectionTimeout>15000</connectionTimeout>
    <readTimeout>${DF_API_READ_TIMEOUT_MS}</readTimeout>
    <headers>
      <header>
        <field>auth</field>
        <name>Authorization</name>
      </header>
    </headers>
    <parameters>
    </parameters>
    <matrixParameters>
    </matrixParameters>
    <result>
      <name>response</name>
      <code>http_status</code>
      <response_time>response_ms</response_time>
      <response_header/>
    </result>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Drop request secrets</name>
    <type>SelectValues</type>
    <description>Removes the request body / file content and the bearer token before anything is logged.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <select_unspecified>N</select_unspecified>
      <remove>
        <name>body</name>
      </remove>
      <remove>
        <name>auth</name>
      </remove>
      <remove>
        <name>url</name>
      </remove>
    </fields>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Show status</name>
    <type>WriteToLog</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>DataFusion API ${API_PATH}</logmessage>
    <fields>
      <field>
        <name>http_status</name>
      </field>
      <field>
        <name>response_ms</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>HTTP 2xx?</name>
    <type>FilterRows</type>
    <description>Anything outside 200-299 fails the pipeline, so the workflow run shows as failed.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Write response to file</send_true_to>
    <send_false_to>Show error</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>http_status</leftvalue>
            <function>&gt;=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>200</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>#</mask>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>http_status</leftvalue>
            <function>&lt;</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>300</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>#</mask>
            </value>
          </condition>
          <condition>
            <negated>Y</negated>
            <operator>AND</operator>
            <leftvalue>response</leftvalue>
            <function>CONTAINS</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>datafusion_error</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
          </condition>
        </conditions>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write response to file</name>
    <type>TextFileOutput</type>
    <description>Saves the API response as ${OUTPUT_FILE}.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <schema_definition/>
    <separator/>
    <enclosure/>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>N</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${OUTPUT_FILE}</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extention/>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>Y</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field>
        <name>response</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>48</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Show error</name>
    <type>WriteToLog</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>DataFusion API ${API_PATH}</logmessage>
    <fields>
      <field>
        <name>response</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Fail with API error</name>
    <type>Abort</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>N</always_log_rows>
    <row_threshold>0</row_threshold>
    <message>DataFusion API returned an error; see the response above. (Request body and token are never logged.)</message>
    <attributes/>
    <GUI>
      <xloc>1248</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
