<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>call-datafusion-api</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reusable DataFusion API call used by every workflow.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>API_PATH</name>
        <default_value>/health</default_value>
        <description>Path under DF_API_URL</description>
      </parameter>
      <parameter>
        <name>HTTP_METHOD</name>
        <default_value>GET</default_value>
        <description>GET or POST</description>
      </parameter>
      <parameter>
        <name>BODY_JSON</name>
        <default_value>{}</default_value>
        <description>JSON request body for POST</description>
      </parameter>
      <parameter>
        <name>API_TOKEN</name>
        <default_value>${DF_API_TOKEN}</default_value>
        <description>Bearer token (steward by default)</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/25 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/25 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Build request</from>
      <to>Call DataFusion API</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Call DataFusion API</from>
      <to>Drop request secrets</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Drop request secrets</from>
      <to>Show response</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Show response</from>
      <to>HTTP 2xx?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HTTP 2xx?</from>
      <to>Success</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HTTP 2xx?</from>
      <to>Fail with API error</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Build request</name>
    <type>GetVariable</type>
    <description>Turns the workflow parameters into one request row.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>url</name>
        <variable>${DF_API_URL}${API_PATH}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>method</name>
        <variable>${HTTP_METHOD}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>body</name>
        <variable>${BODY_JSON}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>auth</name>
        <variable>Bearer ${API_TOKEN}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Call DataFusion API</name>
    <type>Rest</type>
    <description>Calls the DataFusion API with the Hop service token.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <applicationType>JSON</applicationType>
    <connection_name/>
    <url/>
    <urlInField>Y</urlInField>
    <urlField>url</urlField>
    <dynamicMethod>Y</dynamicMethod>
    <methodFieldName>method</methodFieldName>
    <method>POST</method>
    <bodyField>body</bodyField>
    <httpLogin/>
    <httpPassword>Encrypted </httpPassword>
    <proxyHost/>
    <proxyPort/>
    <trustStoreFile/>
    <trustStorePassword>Encrypted </trustStorePassword>
    <ignoreSsl>N</ignoreSsl>
    <connectionTimeout>15000</connectionTimeout>
    <readTimeout>${DF_API_READ_TIMEOUT_MS}</readTimeout>
    <headers>
      <header>
        <field>auth</field>
        <name>Authorization</name>
      </header>
    </headers>
    <parameters>
    </parameters>
    <matrixParameters>
    </matrixParameters>
    <result>
      <name>response</name>
      <code>http_status</code>
      <response_time>response_ms</response_time>
      <response_header/>
    </result>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Drop request secrets</name>
    <type>SelectValues</type>
    <description>Removes the request body (may hold a password) and the bearer token before anything is logged.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <select_unspecified>N</select_unspecified>
      <remove>
        <name>body</name>
      </remove>
      <remove>
        <name>auth</name>
      </remove>
    </fields>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Show response</name>
    <type>WriteToLog</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>DataFusion API ${HTTP_METHOD} ${API_PATH}</logmessage>
    <fields>
      <field>
        <name>http_status</name>
      </field>
      <field>
        <name>response_ms</name>
      </field>
      <field>
        <name>response</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>HTTP 2xx?</name>
    <type>FilterRows</type>
    <description>Anything outside 200-299 fails the pipeline, so the workflow run shows as failed.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Success</send_true_to>
    <send_false_to>Fail with API error</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>http_status</leftvalue>
            <function>&gt;=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>200</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>#</mask>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>http_status</leftvalue>
            <function>&lt;</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>300</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>#</mask>
            </value>
          </condition>
          <condition>
            <negated>Y</negated>
            <operator>AND</operator>
            <leftvalue>response</leftvalue>
            <function>CONTAINS</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>datafusion_error</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
          </condition>
        </conditions>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Success</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>

    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>48</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Fail with API error</name>
    <type>Abort</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>N</always_log_rows>
    <row_threshold>0</row_threshold>
    <message>DataFusion API returned an error; see the response above. (Request body and token are never logged.)</message>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
